<%= form_with model: user do |form| %>
  <% if form.object.errors.any? %>
    <p class="error"><%= form.object.errors.full_messages.first %></p>
  <% end %>


  <div>
    <%= form.label :name, "名前"%>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :furigana, "フリガナ" %>
    <%= form.text_field :furigana %>
  </div>

  <div>
    <%= form.label :gender, "性別" %>
    <%= form.select :gender, ["男", "女", "その他"] %>
  </div>

  <div>
    <%= form.label :phone, "電話" %>
    <%= form.text_field :phone %>
  </div>

  <div>
    <%= form.label :mobile, "携帯" %>
    <%= form.text_field :mobile %>
  </div>

  <div>
    <%= form.label :email, "メール" %>
    <%= form.text_field :email %>
  </div>
    <div>
    <%= form.label :post_code, "郵便番号" %>
    <%= form.text_field :post_code %>
  </div>  <div>
    <%= form.label :address, "住所" %>
    <%= form.text_field :address %>
  </div>  <div>
    <%= form.label :birthday, "誕生日" %>
    <%= form.date_field :birthday %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
