<h1><%= @user.name %></h1>

<p>ふりがな : <%= @user.furigana%></p>
<p>性別 : <%= @user.gender%></p>
<p>電話 : <%= @user.phone%></p>
<p>携帯 : <%= @user.mobile%></p>
<p>メール : <%= @user.email%></p>
<p>郵便番号 : <%= @user.post_code%></p>
<p>住所 : <%= @user.address%></p>
<p>誕生日 : <%= @user.birthday%></p>

<%= link_to "Back", users_path %>
<%= link_to "Edit", edit_user_path(@user) %>
<%= button_to "Delete", @user, method: :delete, data: { turbo_confirm: "Are you sure?" } %>
